# ============ copy this file to ".env" and edit ============

# --- Secrets (CHANGE THESE) -------------------------------------------------
# Signs identity and task tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Protects the admin endpoints (reset, release agent, human review)
ADMIN_KEY=change-me-admin-key
# The "classic" shared key used only by the BASELINE comparison mode
BASELINE_API_KEY=shared-static-key-123

# --- Where the gateway runs ---------------------------------------------------
GATEWAY_URL=http://127.0.0.1:8000
# true = /admin/reset works (wipes the audit log). Set false outside demos.
DEMO_MODE=true

# --- Corrective LLM + audit LLM (OPTIONAL; everything works without it) -------
# none | ollama | groq | gemini | openrouter
LLM_PROVIDER=none
# Only needed for groq / gemini / openrouter (NOT for ollama):
LLM_API_KEY=
# Optional overrides (defaults are set per provider in config.py):
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=
LLM_TIMEOUT=8

# --- Simulated agent "thinking time" in seconds (leave as is) ------------------
THINK_MIN=0.10
THINK_MAX=0.40
